# PharmaCart local web loop - development defaults.
# Every value below is optional; the defaults are the documented local loopback services.
# All three destinations are validated against a fixed loopback allowlist (http://127.0.0.1:<port>).
# Nothing here is a credential. The web app never receives database credentials.

# Origin this app is served from. Must match the OIDC redirect URI registered in infra/oidc/provider.ts.
PHARMACART_WEB_ORIGIN=http://127.0.0.1:3001

# Existing local PharmaCart API. Also used as the OAuth resource indicator.
PHARMACART_WEB_API_ORIGIN=http://127.0.0.1:3000

# Existing local synthetic OIDC provider.
PHARMACART_WEB_OIDC_ISSUER=http://127.0.0.1:55433

# Upper bound for a browser session, in seconds. The effective lifetime is the smaller of this value
# and the access-token expiry, so a session can never outlive its access token (token TTL is 300s).
PHARMACART_WEB_SESSION_MAX_SECONDS=300
