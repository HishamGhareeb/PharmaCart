{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharmacart.local/schemas/decimal.schema.json",
  "title": "Canonical decimal strings",
  "$defs": {
    "canonical": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(?:0|0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?|-(?:0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?))$"
    },
    "nonNegative": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(?:0|0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?)$"
    },
    "positive": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(?:0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?)$"
    }
  },
  "$ref": "#/$defs/canonical"
}
