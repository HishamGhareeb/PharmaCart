{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharmacart.local/schemas/order-lookup.schema.json",
  "title": "OrderLookup",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "externalOrderId"],
      "properties": {
        "kind": { "const": "found" },
        "externalOrderId": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "authoritativeAt", "retryPermitted"],
      "properties": {
        "kind": { "const": "not_found" },
        "authoritativeAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
          "minLength": 20,
          "maxLength": 64
        },
        "retryPermitted": {
          "type": "boolean",
          "deprecated": true,
          "description": "Untrusted adapter claim retained for wire compatibility; never authorizes retry."
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reconciliationRef"],
      "properties": {
        "kind": { "const": "inconclusive" },
        "reconciliationRef": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  ]
}
